{
    "name": "timenote-server",
    "version": "1.0.0",
    "private": true,
    "description": "Nest TypeScript starter repository",
    "scripts": {
        "prebuild": "oxlint --config .oxlintrc.build.json 'src/modules'",
        "db:sync": "drizzle-kit generate && drizzle-kit migrate",
        "db:sync:safe": "tsx scripts/sync-schema.ts",
        "db:check": "tsx scripts/check-schema-safety.ts",
        "db:rename": "tsx scripts/rename-table.ts",
        "start": "nest start",
        "dev": "NODE_ENV=development nest start --watch",
        "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && pnpm run dev",
        "debug": "NODE_ENV=development nest start --debug --watch",
        "prod": "NODE_ENV=production node dist/main",
        "build": "nest build",
        "deploy": "nest deploy",
        "kill:port": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo 'Port 3000 is free'",
        "commit": "git add . && cz",
        "pull": "git pull",
        "push": "git push",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "prepare": "lefthook install",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
    },
    "dependencies": {
        "@fastify/multipart": "^10.1.1",
        "@nestjs-cls/transactional": "^3.2.2",
        "@nestjs-cls/transactional-adapter-drizzle-orm": "^1.4.1",
        "@nestjs/common": "^12.0.1",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.1",
        "@nestjs/jwt": "^12.0.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/observe": "^0.1.8",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-fastify": "^12.0.1",
        "drizzle-orm": "1.0.0-rc.4",
        "fastify": "^5.12.1",
        "ms": "^2.1.3",
        "mysql2": "^3.23.3",
        "nest-winston": "^1.10.2",
        "nestjs-cls": "^6.2.2",
        "nestjs-zod": "^5.5.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.10.8",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "commitizen": "^4.3.2",
        "commitlint": "^21.2.2",
        "concurrently": "^9.0.0",
        "cz-git": "^1.13.2",
        "drizzle-kit": "1.0.0-rc.4",
        "lefthook": "^2.1.10",
        "oxfmt": "^0.63.0",
        "oxlint": "^0.15.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.12",
        "typescript": "^6.0.2",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.1.2"
    },
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git",
            "useEmoji": true
        }
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    }
}

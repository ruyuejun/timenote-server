root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.js]
indent_size = 4

[*.jsx]
indent_size = 4

[*.ts]
indent_size = 4

[*.tsx]
indent_size = 4

[*.css]
indent_size = 4

[*.scss]
indent_size = 4

[*.vue]
indent_size = 4

[*.html]
indent_size = 4

[*.kt]
indent_size = 4
max_line_length = 120

[*.kts]
indent_size = 4

[*.xml]
indent_size = 4
